{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/analyze.py": {
      "maxDuration": 60,
      "includeFiles": "backend/app/**"
    },
    "api/health.py": {
      "maxDuration": 10,
      "includeFiles": "backend/app/**"
    }
  },
  "rewrites": [
    {
      "source": "/sb/:path*",
      "destination": "https://tlsaccyapnfnxxritbbl.supabase.co/:path*"
    },
    {
      "source": "/((?!api/|sb/).*)",
      "destination": "/index.html"
    }
  ]
}
